[Unit]
Description=Expense tracker (Flask via gunicorn)
After=network.target

[Service]
User=tracker
Group=tracker
WorkingDirectory=/opt/tracker
# One worker only: app.py rewrites data.csv without locking
ExecStart=/opt/tracker/venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8000 app:app
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
